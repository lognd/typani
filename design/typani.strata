// typani.strata -- typani's own architecture, modeled in strata (frob's
// provable system-design language). typani is the FIRST sibling-repo
// strata pilot: a small, pure Python Result/Option/ErrorSet library with
// no I/O of its own. This file is dual-purpose -- it documents typani's
// real module graph as enforced truth (`frob sys audit` gates on the
// nodes/flows below matching what actually imports what in src/typani/),
// and it exists to bug-hunt strata itself against a codebase it was not
// built against.
//
// Every node's `code` glob was chosen by reading src/typani/*.py and
// src/typani/lint/*.py directly (T-0013 extended the original 9-file/
// ~1000-line survey with the propagation/backend-selection/version/lint
// modules split out during the 0.1 redesign; see tickets.md
// T-0001/T-0002 for the two pre-existing frob adoption gaps this model
// does not re-litigate). Every flow below is a real
// `from typani.X import ...` edge, confirmed by grepping each file's
// import block (top-level AND the lazy imports inside method bodies used
// to break Result<->Option/exceptions cycles) -- no aspirational edges.
//
// Capability surface: a direct grep of src/typani/ for subprocess/
// os.system/open(/socket/requests/urllib/eval(/exec(/__import__ found
// ZERO matches -- typani does no filesystem, network, process, or
// dynamic-eval I/O anywhere. Two narrow exceptions exist and are
// declared below rather than hidden: `_impl.py` reads `TYPANI_PURE`
// from `os.environ` to select the backend (`may "env.read"`), and
// `lint/__init__.py` reads `*.py` source files from disk to lint them
// (`may "fs-read"`). Every other node still declares NO `may`
// capabilities at all -- `frob sys audit`'s self-conformance check
// (SYS103/SYS106) would flag a stale `may`, or a missing one, the
// moment any node's code diverged from what is declared here.

// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
module typani

// -- nodes ----------------------------------------------------------

// Public re-export surface: src/typani/__init__.py. Imports every leaf
// module and re-exports its public names in __all__; nothing else in
// this repo imports through anything but this file (or a leaf module
// directly, which the flows below also cover since tests/examples import
// leaves directly too -- see docs/index.md).
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
node api : trusted {
    clearance Public;
    code "src/typani/__init__.py";
}

// src/typani/unit.py: Unit/UnitMeta, the zero-information sentinel type
// every other value type in this repo is built from (_OK_UNIT,
// _EMPTY_UNIT, _SOME_UNIT all subclass Unit). Leaf: imports nothing
// else in typani.
// frob:doc docs/unit.md#unit
// frob:ticket T-0005
node unit : trusted {
    clearance Public;
    code "src/typani/unit.py";
}

// src/typani/unreachable.py: Unreachable, a Unit subclass used to mark
// statically-unreachable branches (uses stdlib `inspect` only, no
// typani-internal import besides unit).
// frob:doc docs/unreachable.md#unreachable
// frob:ticket T-0005
node unreachable_mod : trusted {
    clearance Public;
    code "src/typani/unreachable.py";
}

// src/typani/dispatch.py: dispatch(), a structural-pattern-matching
// helper. Leaf: imports nothing else in typani.
// frob:doc docs/dispatch.md#dispatch
// frob:ticket T-0005
node dispatch_mod : trusted {
    clearance Public;
    code "src/typani/dispatch.py";
}

// src/typani/error_set.py: ErrorSet/_ErrorSetMeta/merge. Built on
// stdlib enum + weakref only; imports nothing else in typani.
// frob:doc docs/error_set.md#errorset
// frob:ticket T-0005
node error_set_mod : trusted {
    clearance Public;
    code "src/typani/error_set.py";
}

// src/typani/option.py: Option/Some/Nothing. T-0009 dropped the Unit
// dependency (no `from typani.unit import` remains in this file);
// imports _exceptions (UnwrapError) at module scope, and result.py
// (Ok/Err/Result) both under TYPE_CHECKING and as lazy in-method imports
// (ok_or/ok_or_else, and the native-backend rebind block) to avoid a
// module-level import cycle with result.py.
// frob:doc docs/option.md#option
// frob:ticket T-0005
// frob:ticket T-0013
node option_mod : trusted {
    clearance Public;
    code "src/typani/option.py";
}

// src/typani/result.py: Result/Ok/Err. T-0009 dropped the Unit
// dependency (no `from typani.unit import` remains in this file);
// imports _exceptions (UnwrapError) at module scope, and option.py
// (Some/Nothing) both under TYPE_CHECKING and as lazy in-method imports
// (Ok.to_option/Err.to_option, and the native-backend rebind block) to
// avoid a module-level import cycle with option.py.
// frob:doc docs/result.md#result
// frob:ticket T-0005
// frob:ticket T-0013
node result_mod : trusted {
    clearance Public;
    code "src/typani/result.py";
}

// src/typani/sum.py: Sum, a tagged-union type whose .match()/.check()
// are implemented on top of dispatch().
// frob:doc docs/sum.md#sum
// frob:ticket T-0005
node sum_mod : trusted {
    clearance Public;
    code "src/typani/sum.py";
}

// src/typani/singleton.py: Singleton/StrictSingleton and friends.
// Excluded from the frob graph itself (frob.toml [graph].exclude,
// T-0001 -- the frob 0.1.0a0 graph builder crashes on this file's
// @typing.overload chain), but the file exists and has no internal
// typani import, so it is still modeled here as a leaf node with no
// inbound/outbound typani flows besides `api`'s re-export.
// frob:doc docs/singleton.md#singleton
// frob:ticket T-0005
node singleton_mod : trusted {
    clearance Public;
    code "src/typani/singleton.py";
}

// src/typani/_exceptions.py: UnwrapError, the AssertionError subclass
// raised by every unwrap()/danger_* misuse. Carries the offending
// Result/Option in `.container`, so its `_default_message` helper
// imports Ok/Err/Some/Nothing (lazily, inside the method, to avoid a
// module-level cycle) purely to render a variant-aware message string --
// no construction, no mutation.
// frob:doc docs/result.md#unwraperror
// frob:ticket T-0013
node exceptions_mod : trusted {
    clearance Public;
    code "src/typani/_exceptions.py";
}

// src/typani/_propagate.py: propagate()/catching(), the Rust-`?`-style
// early-return decorator and the exception-to-Result boundary decorator.
// `propagate` catches UnwrapError and returns its `.container`;
// `catching` wraps a function in `Result.catch` semantics.
// frob:doc docs/result.md#propagation
// frob:ticket T-0013
node propagate_mod : trusted {
    clearance Public;
    code "src/typani/_propagate.py";
}

// src/typani/_impl.py: native_active()/backend_name(), the backend
// selection between the typani_core PyO3 extension and the pure-Python
// classes in result.py/option.py. Reads the TYPANI_PURE environment
// variable via os.environ.get, hence the sole `may "env.read"` grant in
// this model -- no other node touches the environment.
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
node impl_mod : trusted {
    clearance Public;
    code "src/typani/_impl.py";
    may "env.read" via "src/typani/_impl.py";
}

// src/typani/_version.py: the single-source-of-truth __version__
// literal, split out of __init__.py so _impl.py can read it without
// importing typani's full public surface (avoiding a circular import
// between typani/__init__.py and typani/_impl.py) and so
// scripts/bump_version.py has one literal to rewrite. Leaf: imports
// nothing else in typani.
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
node version_mod : trusted {
    clearance Public;
    code "src/typani/_version.py";
}

// src/typani/lint/**: the stdlib-ast misuse checker (python -m
// typani.lint). Deliberately never imported from typani/__init__.py --
// an opt-in dev tool, not part of the runtime package -- so it has no
// inbound flow from `api` and no outbound flow into any other node in
// this model; it imports nothing from typani proper (only stdlib ast/
// argparse/json/pathlib/logging/dataclasses/re plus its own
// submodules). check_paths/_iter_python_files read `*.py` source files
// from disk via Path.read_text/Path.rglob to lint them, hence the sole
// other `may` grant in this model.
// frob:doc docs/lint.md#check_paths
// frob:ticket T-0013
node lint : trusted {
    clearance Public;
    code "src/typani/lint/**";
    may "fs-read" via "src/typani/lint/__init__.py";
}

// T-0015: support nodes for trees `frob sys audit`'s vet pass observes
// real capabilities in but that fall outside src/typani/**'s runtime
// import graph -- see docs/design.md#support-nodes for why each exists.

// crates/typani-core/src/**: the Rust PyO3 extension. `ffi` covers the
// Python/Rust call boundary every #[pyfunction]/#[pyclass] crosses.
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
node native_core : trusted {
    clearance Public;
    code "crates/typani-core/src/**";
    may "ffi" via "crates/typani-core/src/lib.rs";
}

// bench/bench_result.py: the microbenchmark script behind docs/native.md's
// numbers. `deserialize` covers the pickle round-trip it measures.
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
node bench : trusted {
    clearance Public;
    code "bench/bench_result.py";
    may "deserialize" via "bench/bench_result.py";
}

// scripts/*.py: the release/build/dev-loop executables run by the
// Makefile targets and by hand (never imported by tracked source, each
// already declared as a `[[refs.entrypoint]]` in frob.toml). T-0030
// widened this node's `code=` glob from bump_version.py alone to the
// whole scripts/ tree once `frob sys audit` observed real capabilities
// (subprocess exec, env read/write, fs write) in every other script
// file that a narrower glob left unbound (SYS103).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
// frob:ticket T-0030
node scripts : trusted {
    clearance Public;
    code "scripts/*.py";
    may "fs-read" via "scripts/bump_version.py";
    may "fs-write" via "scripts/bump_version.py", "scripts/clean.py", "scripts/release.py";
    may "exec" via "scripts/_common.py", "scripts/build.py", "scripts/check.py", "scripts/develop.py", "scripts/install.py", "scripts/release.py", "scripts/typecheck_oracle.py";
    may "env.read" via "scripts/check.py", "scripts/release.py";
    may "env.write" via "scripts/release.py";
}

// The subset of tests/** the vet pass observes real capabilities in
// (fixtures/config deserialize test data, tests monkeypatch or read
// os.environ, test_lint.py execs `python -m typani.lint` as a
// subprocess, and several tests read/write temp files). Deliberately
// narrower than tests/** as a whole: the other test files (test_result.py,
// test_option.py, ...) import typani's own modules directly and are left
// unmodeled here, same as before T-0015 -- widening this node's code=
// glob to tests/** would turn every one of those ordinary test imports
// into an undeclared cross-component SYS003 finding against this node.
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
// frob:ticket T-0030
node tests : trusted {
    clearance Public;
    code "tests/parity/cases.py" "tests/test_backend.py" "tests/test_bump_version.py" "tests/test_lint.py" "tests/test_option_api.py" "tests/test_result_api.py" "tests/test_scripts.py";
    may "deserialize" via "tests/parity/cases.py", "tests/test_option_api.py", "tests/test_result_api.py";
    may "eval" via "tests/parity/cases.py", "tests/test_bump_version.py", "tests/test_scripts.py";
    may "exec" via "tests/test_backend.py", "tests/test_lint.py", "tests/test_result_api.py", "tests/test_scripts.py";
    // T-0030: test_result_api.py:196 monkeypatches os.environ to exercise
    // native/pure backend parity, the same env.read shape test_backend.py
    // already declares.
    may "env.read" via "tests/test_backend.py", "tests/test_result_api.py";
    may "fs.read" via "tests/test_bump_version.py", "tests/test_lint.py";
    may "fs.write" via "tests/test_bump_version.py", "tests/test_lint.py", "tests/test_scripts.py";
}

// -- flows ------------------------------------------------------------

// api re-exports every leaf module's public names (__init__.py's import
// block, one line per module). Every flow below is `attr local;`: this
// is a single in-process package with no process/service boundary
// anywhere in it (module import, not RPC), so REL200's deny-by-default
// timeout obligation is an explicit, honest exemption rather than a
// silently-missing one.
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_unit : api -> unit { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_unreachable : api -> unreachable_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_dispatch : api -> dispatch_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_error_set : api -> error_set_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_option : api -> option_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_result : api -> result_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_sum : api -> sum_mod { label Public; attr local; }
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
flow f_api_singleton : api -> singleton_mod { label Public; attr local; }
// __init__.py: `from typani._exceptions import UnwrapError`.
// frob:doc docs/result.md#unwraperror
// frob:ticket T-0013
flow f_api_exceptions : api -> exceptions_mod { label Public; attr local; }
// __init__.py: `from typani._impl import backend_name, native_active`.
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
flow f_api_impl : api -> impl_mod { label Public; attr local; }
// __init__.py: `from typani._propagate import catching, propagate`.
// frob:doc docs/result.md#propagation
// frob:ticket T-0013
flow f_api_propagate : api -> propagate_mod { label Public; attr local; }
// __init__.py: `from typani._version import __version__`.
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
flow f_api_version : api -> version_mod { label Public; attr local; }

// unreachable.py: `from typani.unit import Unit`.
// frob:doc docs/unreachable.md#unreachable
// frob:ticket T-0005
flow f_unreachable_unit : unreachable_mod -> unit { label Public; attr local; }

// sum.py: `from typani.dispatch import dispatch`.
// frob:doc docs/sum.md#sum
// frob:ticket T-0005
flow f_sum_dispatch : sum_mod -> dispatch_mod { label Public; attr local; }

// _exceptions.py: `from typani.option import Option` (TYPE_CHECKING) and
// `from typani.option import Nothing, Some` (lazy, inside
// _default_message, to render a variant-aware error message).
// frob:doc docs/result.md#unwraperror
// frob:ticket T-0013
flow f_exceptions_option : exceptions_mod -> option_mod { label Public; attr local; }

// _exceptions.py: `from typani.result import Result` (TYPE_CHECKING) and
// `from typani.result import Err, Ok` (lazy, inside _default_message).
// frob:doc docs/result.md#unwraperror
// frob:ticket T-0013
flow f_exceptions_result : exceptions_mod -> result_mod { label Public; attr local; }

// _propagate.py: `from typani._exceptions import UnwrapError`.
// frob:doc docs/result.md#propagation
// frob:ticket T-0013
flow f_propagate_exceptions : propagate_mod -> exceptions_mod { label Public; attr local; }

// _propagate.py: `from typani.result import Err, Ok, Result`.
// frob:doc docs/result.md#propagation
// frob:ticket T-0013
flow f_propagate_result : propagate_mod -> result_mod { label Public; attr local; }

// _propagate.py: `import typani.option as _option_module` (T-0030,
// module-scope, used by _owned_codes_for's internal-frame check
// alongside _result_module).
// frob:doc docs/result.md#propagation
// frob:ticket T-0030
flow f_propagate_option : propagate_mod -> option_mod { label Public; attr local; }

// result.py: `from typani._exceptions import UnwrapError`.
// frob:doc docs/result.md#result
// frob:ticket T-0013
flow f_result_exceptions : result_mod -> exceptions_mod { label Public; attr local; }

// result.py: `from typani.option import Option` (TYPE_CHECKING), plus
// lazy `from typani.option import Some` (Ok.to_option) and
// `from typani.option import Nothing` (Err.to_option).
// frob:doc docs/result.md#to_option---optiont
// frob:ticket T-0013
flow f_result_option : result_mod -> option_mod { label Public; attr local; }

// result.py: `from typani._impl import native_active as _native_active`
// (module-bottom native-backend rebind block, not TYPE_CHECKING).
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
flow f_result_impl : result_mod -> impl_mod { label Public; attr local; }

// option.py: `from typani._exceptions import UnwrapError`.
// frob:doc docs/option.md#option
// frob:ticket T-0013
flow f_option_exceptions : option_mod -> exceptions_mod { label Public; attr local; }

// option.py: `from typani.result import Result` (TYPE_CHECKING), plus
// lazy `from typani.result import Err, Ok` in ok_or/ok_or_else.
// frob:doc docs/option.md#ok_orerr---resultt-e
// frob:ticket T-0013
flow f_option_result : option_mod -> result_mod { label Public; attr local; }

// option.py: `from typani._impl import native_active as _native_active`
// (module-bottom native-backend rebind block, not TYPE_CHECKING).
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
flow f_option_impl : option_mod -> impl_mod { label Public; attr local; }

// _impl.py: `from typani._version import __version__ as _TYPANI_VERSION`.
// frob:doc docs/native.md#backend-selection
// frob:ticket T-0013
flow f_impl_version : impl_mod -> version_mod { label Public; attr local; }

// tests: `import typani` (parity/cases.py, test_backend.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_api : tests -> api { label Public; attr local; }
// tests: `from typani.option import ...` (parity/cases.py,
// test_option_api.py, test_result_api.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_option : tests -> option_mod { label Public; attr local; }
// tests: `from typani.result import ...` (parity/cases.py,
// test_option_api.py, test_result_api.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_result : tests -> result_mod { label Public; attr local; }
// tests: `from typani._exceptions import UnwrapError` (test_option_api.py,
// test_result_api.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_exceptions : tests -> exceptions_mod { label Public; attr local; }
// tests: `from typani.lint import ...` (test_lint.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_lint : tests -> lint { label Public; attr local; }
// tests: `import typani._impl as _impl` (test_backend.py).
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_tests_impl : tests -> impl_mod { label Public; attr local; }

// bench/bench_result.py: `import typani` plus `from typani.option import
// Nothing, Some` and `from typani.result import Err, Ok` to benchmark the
// public Result/Option construction/accessor hot path.
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_bench_api : bench -> api { label Public; attr local; }
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_bench_option : bench -> option_mod { label Public; attr local; }
// frob:doc docs/design.md#support-nodes
// frob:ticket T-0015
flow f_bench_result : bench -> result_mod { label Public; attr local; }

// -- claims ------------------------------------------------------------

// Sanity check that api's re-export surface actually reaches every leaf
// module it claims to re-export (mirrors frob.strata's own
// c_gates_reach_tickets pattern: catch an accidentally-drawn dead end).
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
assert c_api_reaches_result reach api -> result_mod
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
assert c_api_reaches_option reach api -> option_mod
// frob:doc docs/index.md#typani-documentation
// frob:ticket T-0005
assert c_api_reaches_sum reach api -> sum_mod

// singleton.py has no internal typani import and nothing internal
// imports it (only api's re-export touches it) -- it is architecturally
// isolated within this repo, true today per direct read of
// src/typani/singleton.py's import block.
// frob:doc docs/singleton.md#singleton
// frob:ticket T-0005
assert c_singleton_isolated_from_result noflow singleton_mod -> result_mod
// frob:doc docs/singleton.md#singleton
// frob:ticket T-0005
assert c_result_isolated_from_singleton noflow result_mod -> singleton_mod

// error_set.py is a leaf with no internal typani import (stdlib enum +
// weakref only) and nothing internal typani module imports it back --
// true today per direct read of src/typani/error_set.py's import block.
// frob:doc docs/error_set.md#errorset
// frob:ticket T-0005
assert c_error_set_isolated noflow error_set_mod -> unit

// lint is deliberately never imported from typani/__init__.py or any
// other node in this model -- it is an opt-in dev tool invoked as
// `python -m typani.lint`, not part of the runtime import graph.
// frob:doc docs/lint.md#check_paths
// frob:ticket T-0013
assert c_lint_isolated_from_api noflow api -> lint
